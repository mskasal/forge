# Copy to deploy/remote/.env (chmod 600, git-ignored) for `docker compose --profile remote up -d`.

# Cloudflare Zero Trust Tunnel token (route your hostname e.g. forge.example.com -> http://forge-caddy:8080)
CLOUDFLARE_TUNNEL_TOKEN=

# OAuth2-Proxy (Google or GitHub sign-in before reaching Forge preview)
OAUTH2_PROXY_PROVIDER=google
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
OAUTH2_PROXY_COOKIE_SECRET=
OAUTH2_PROXY_EMAIL_DOMAINS=*
# Restrict to specific emails (recommended: mount an emails file or set authenticated-emails-file)
OAUTH2_PROXY_REDIRECT_URL=https://forge.example.com/oauth2/callback
